{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blorenge Fell Race 2025 public results",
  "type": "array",
  "minItems": 102,
  "maxItems": 102,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "year",
      "position",
      "raceNumber",
      "runnerName",
      "club",
      "category",
      "categoryPosition",
      "genderPosition",
      "recordedGenderCategory",
      "finishTime"
    ],
    "properties": {
      "year": { "const": 2025 },
      "position": { "type": "integer", "minimum": 1 },
      "raceNumber": { "type": "integer", "minimum": 1 },
      "runnerName": { "type": "string", "minLength": 1 },
      "club": { "type": "string" },
      "category": { "type": "string", "minLength": 1 },
      "categoryPosition": { "type": "integer", "minimum": 1 },
      "genderPosition": { "type": "integer", "minimum": 1 },
      "recordedGenderCategory": { "enum": ["Male", "Female"] },
      "finishTime": { "type": "string", "pattern": "^[0-9]{2}:[0-5][0-9]:[0-5][0-9]$" }
    }
  }
}
